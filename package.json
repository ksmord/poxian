{
  "name": "poxian",
  "version": "0.1.9",
  "description": "poxian · magpie 网关异步钩子中间件 + 控制台页面：把完整工作台系统提示词写进每一个经过网关的请求，落在各协议自己的 system 位置。上游 fork 自 https://github.com/YaoGuaiLi/hangong",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "assets/icon.svg",
    "cases.json",
    "docs/architecture.svg",
    "docs/sequence.svg",
    "page/",
    "page/icon.svg",
    "poxian-prompt.js",
    "poxian.test.mjs",
    "prompts/",
    "prefilter/",
    "scripts/build-prompts.mjs",
    "scripts/check-page.mjs",
    "scripts/render-diagrams.mjs",
    "poxian.hooks.mjs",
    "src/",
    "test/",
    "poxian.middleware.js"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "system-prompt",
    "opencode",
    "opencode-plugin",
    "llm-gateway",
    "prompt",
    "magpie-hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksmord/poxian.git"
  },
  "homepage": "https://github.com/YaoGuaiLi/hangong",
  "magpie": {
    "hooks": "./poxian.hooks.mjs",
    "options": {
      "enabled": true,
      "override": true,
      "position": "prepend",
      "cache": false,
      "handshake": true,
      "handshake_model": "",
      "models": [],
      "agents_off": [],
      "prompt": "v5",
      "on_prompt": "",
      "agents": [],
      "prompt_path": "",
      "strip_frontmatter": true,
      "gatewayTimeoutMs": 3000,
      "log": true,
      "log_path": "~/.config/magpie/logs/poxian.jsonl",
      "log_backup_count": 1,
      "skip_stream": false,
      "dry_run": false,
      "max_payload_bytes": 0,
      "prompt_allowlist": [],
      "enable_message_filter": false,
      "strip_safety_system": true,
      "strip_deny_assistant": false,
      "probe_echo": false,
      "probe_refusal": false,
      "override_mode": "replace",
      "prefill": "",
      "prefill_models": [],
      "prefill_auto": true
    },
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "poxian",
      "titles": {
        "en": "poxian",
        "zh": "poxian",
        "zh-TW": "poxian",
        "ja": "poxian"
      },
      "file": "page/index.html",
      "icon": "assets/icon.svg"
    }
  },
  "scripts": {
    "test": "node --test test/",
    "build": "node scripts/build-prompts.mjs",
    "check": "node scripts/check-page.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:hooks": "node -e \"import('./poxian.hooks.mjs').then(m=>console.log(Object.keys(m)))\""
  },
  "main": "./poxian.hooks.mjs",
  "exports": {
    ".": "./poxian.hooks.mjs",
    "./middleware": "./poxian.middleware.js",
    "./prompt": "./poxian-prompt.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "ksmord",
  "contributors": [
    {
      "name": "YaoGuaiLi",
      "url": "https://github.com/YaoGuaiLi/hangong"
    }
  ]
}
