{
  "name": "poxian",
  "version": "1.4.0",
  "description": "poxian · magpie 网关系统提示词中间件 + 控制台页面：把完整工作台系统提示词写进每一个经过网关的请求，落在各协议自己的 system 位置。上游 fork 自 https://github.com/YaoGuaiLi/hangong",
  "type": "module",
  "files": [
    "poxian.middleware.js",
    "poxian-prompt.js",
    "README.md",
    "LICENSE",
    "cases.json",
    "poxian.test.mjs",
    "prompts/",
    "assets/icon.svg",
    "docs/architecture.svg",
    "docs/sequence.svg",
    "scripts/build-prompts.mjs",
    "scripts/check-page.mjs",
    "scripts/render-diagrams.mjs",
    "page/"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "system-prompt",
    "opencode",
    "opencode-plugin",
    "llm-gateway",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksmord/poxian.git"
  },
  "homepage": "https://github.com/YaoGuaiLi/hangong",
  "magpie": {
    "middleware": "./poxian.middleware.js",
    "options": {
      "override": true,
      "position": "prepend"
    }
  },
  "scripts": {
    "test": "node poxian.test.mjs",
    "build": "node scripts/build-prompts.mjs",
    "check": "node scripts/check-page.mjs",
    "diagrams": "node scripts/render-diagrams.mjs"
  }
}
