  {
    "name": "Chat: a request without a system message gets one",
    "ctx": {
      "protocol": "chat"
    },
    "options": {
      "on_prompt": "P."
    },
    "request": {
      "model": "m",
      "messages": [
        {
          "role": "user",
          "content": "hi"
        }
      ]
    },
    "expect_request": {
      "model": "m",
      "messages": [
        {
          "role": "system",
          "content": "<!--poxian-->\nP."
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    }
  },
  {
    "name": "Chat: override prepends into a developer message",
    "ctx": {
      "protocol": "chat"
    },
    "options": {
      "on_prompt": "P.",
      "override": true
    },
    "request": {
      "model": "m",
      "messages": [
        {
          "role": "developer",
          "content": "You code."
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    },
    "expect_request": {
      "model": "m",
      "messages": [
        {
          "role": "developer",
          "content": "<!--poxian-->\nP.\nYou code."
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    }
  },
  {
    "name": "Chat: developer message with a parts array",
