[
  {
    "name": "Anthropic: no system prompt is given this one",
    "options": {
      "on_prompt": "P."
    },
    "request": {
      "model": "m",
      "messages": []
    },
    "expect_request": {
      "model": "m",
      "messages": [],
      "system": [
        {
          "type": "text",
          "text": "<!--poxian-->\nP.",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  },
  {
    "name": "Anthropic: override prepends to a string (default position)",
    "options": {
      "on_prompt": "P.",
      "override": true
    },
    "request": {
      "model": "m",
      "system": "You code."
    },
    "expect_request": {
      "model": "m",
      "system": [
        {
          "type": "text",
          "text": "<!--poxian-->\nP.",
          "cache_control": {
            "type": "ephemeral"
          }
        },
        {
          "type": "text",
          "text": "You code."
        }
      ]
    }
  },
