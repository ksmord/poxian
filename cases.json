  {
    "name": "handshake: exact 寒霜 gets the tiny handshake prompt, not 79K",
    "ctx": {
      "protocol": "chat"
    },
    "options": {
      "handshake_model": "cheap/fast"
    },
    "request": {
      "model": "expensive/x",
      "messages": [
        {
          "role": "system",
          "content": "Agent own prompt"
        },
        {
          "role": "user",
          "content": " 寒霜 "
        }
      ]
    },
    "expect_request": {
      "model": "cheap/fast",
      "messages": [
        {
          "role": "system",
          "content": {
            "__startsWith": "<!--poxian-->\nYou are the poxian workbench kernel. The user"
          }
        },
        {
          "role": "user",
          "content": " 寒霜 "
        }
      ]
    }
  },
